{
  "applications": {
    "Shopularity.Admin": {
      "type": "dotnet-project",
      "launchUrl": "https://localhost:44365",
      "healthCheckEndpoint": "/",
      "path": "../../app/Shopularity.Admin/Shopularity.Admin.csproj",
      "execution": {
        "order": 0
      },
      "folder": "Apps"
    },
    "Shopularity.Public": {
      "type": "dotnet-project",
      "path": "../../app/Shopularity.Public/Shopularity.Public.csproj",
      "launchUrl": "https://localhost:53585",
      "folder": "Apps"
    }
  },
  "tasks": {
    "Initialize Solution": {
      "behaviour": 2,
      "startCommand": "./initialize-solution.ps1",
      "workingDirectory": "../../etc/initial-tasks",
      "shortDescription": "Migrates the database, installs client-side libraries, and generates the OpenIddict signing certificate."
    },
    "Migrate Database": {
      "behaviour": 0,
      "startCommand": "./migrate-database.ps1",
      "workingDirectory": "../../etc/initial-tasks",
      "shortDescription": "Migrates the Shopularity database and seeds initial data."
    },
    "Install Client-Side Libraries": {
      "behaviour": 0,
      "startCommand": "./install-libs.ps1",
      "workingDirectory": "../../etc/initial-tasks",
      "shortDescription": "Runs abp install-libs for the solution."
    },
    "Generate Signing Certificate": {
      "behaviour": 0,
      "startCommand": "./generate-certificate.ps1",
      "workingDirectory": "../../etc/initial-tasks",
      "shortDescription": "Generates the OpenIddict development signing certificate."
    }
  },
  "containers": {
    "files": {},
    "serviceName": "Shopularity-containers"
  },
  "folders": {
    "items": {
      "Apps": {}
    }
  }
}